{
  "appId": "com.vaultlix.app",
  "appName": "Vaultlix",
  "webDir": "www",
  "server": {
    "url": "https://vaultlix.com",
    "errorPath": "offline.html",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1A1916",
    "appendUserAgent": "VaultlixNative/1"
  },
  "ios": {
    "appendUserAgent": "VaultlixNative/1"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "LIGHT"
    }
  }
}
